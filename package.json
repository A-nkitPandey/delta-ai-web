{
  "name": "delta-ai-web",
  "type": "module",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "astro dev",
    "build": "CLOUDFLARE_VITE_FORCE_LOCAL=true astro build",
    "preview": "astro build && wrangler dev",
    "check": "astro check",
    "deploy": "astro build && wrangler deploy",
    "db:migrate:local": "wrangler d1 migrations apply delta-leads --local",
    "db:migrate:remote": "wrangler d1 migrations apply delta-leads --remote",
    "types": "wrangler types"
  },
  "dependencies": {
    "@astrojs/cloudflare": "^14.3.4",
    "@astrojs/sitemap": "^3.7.4",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource/instrument-serif": "^5.3.0",
    "astro": "^7.3.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "typescript": "^7.0.2",
    "wrangler": "^4.150.0"
  },
  "engines": {
    "node": ">=22"
  }
}
