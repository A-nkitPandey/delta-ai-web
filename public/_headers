# Security headers for every static page and file.
# The page-level Content-Security-Policy (script/style hashes) is written by
# Astro into each HTML page; these headers add what a <meta> tag can't.
/*
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  X-Content-Type-Options: nosniff
  X-Frame-Options: DENY
  Content-Security-Policy: frame-ancestors 'none'; object-src 'none'; base-uri 'self'
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin
  X-DNS-Prefetch-Control: off

# Hashed build assets never change: cache for a year.
/_astro/*
  Cache-Control: public, max-age=31536000, immutable

# Fonts and icons: cache for a week.
/*.png
  Cache-Control: public, max-age=604800
/favicon.svg
  Cache-Control: public, max-age=604800
