{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "delta-ai-web",
  "main": "@astrojs/cloudflare/entrypoints/server",
  "compatibility_date": "2026-10-01",
  "observability": { "enabled": true },
  // Keep the free *.workers.dev link switched on (useful before and after a custom domain).
  "workers_dev": true,

  // Serve the site on your own domain. Cloudflare creates the DNS records
  // and SSL certificate automatically on deploy.
  "routes": [
    { "pattern": "deltaaiinnovation.in", "custom_domain": true },
    { "pattern": "www.deltaaiinnovation.in", "custom_domain": true }
  ],

  // Public, non-secret settings. Secrets (TURNSTILE_SECRET_KEY,
  // RESEND_API_KEY, IP_HASH_SALT) are set with `npx wrangler secret put`.
  "vars": {
    "CONTACT_TO_EMAIL": "info@deltaaiinnovation.in",
    "CONTACT_FROM_EMAIL": "Delta AI Website <website@deltaaiinnovation.in>",
    // Address the website sends from, and the verified inbox that receives enquiries.
    "CONTACT_SENDER": "website@deltaaiinnovation.in",
    "CONTACT_NOTIFY_TO": "pandey.ankt97@gmail.com"
  },

  // Contact-form notifications. Free: Cloudflare Email Routing can send to
  // a destination address that is already verified on this account.
  "send_email": [
    {
      "name": "EMAIL",
      "destination_address": "pandey.ankt97@gmail.com",
      "allowed_sender_addresses": ["website@deltaaiinnovation.in"]
    }
  ],

  // Free D1 database that stores contact-form leads (created in the
  // Cloudflare dashboard; table created from migrations/0001_create_leads.sql).
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "delta-leads",
      "database_id": "0f292832-fd0d-45f7-8c72-856abc8956df",
      "migrations_dir": "migrations"
    }
  ]
}
