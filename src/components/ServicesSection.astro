---
import { getCollection } from 'astro:content';
import SectionHeading from './SectionHeading.astro';
import ServiceCard from './ServiceCard.astro';

const services = (await getCollection('services', ({ data }) => !data.draft)).sort((a, b) => a.data.order - b.data.order);
const countWords = ['Zero', 'One', 'Two', 'Three', 'Four', 'Five', 'Six', 'Seven', 'Eight', 'Nine', 'Ten'];
const count = countWords[services.length] ?? String(services.length);
---

<section id="services" class="section wrap" aria-labelledby="services-title">
  <div class="top">
    <SectionHeading id="services-title" eyebrow="What we do" before={`${count} ways we move your business`} accent="forward" after="." />
    <p class="muted side">One team for strategy, design, engineering and long-term support — so nothing falls between vendors.</p>
  </div>
  <div class="grid">
    {services.map((s) => <ServiceCard service={s} />)}
  </div>
</section>

<style>
  .top {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    align-items: flex-end;
    gap: 24px;
  }
  .side {
    max-width: 380px;
  }
  .grid {
    margin-top: 56px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(300px, 100%), 1fr));
    gap: 18px;
  }
</style>
