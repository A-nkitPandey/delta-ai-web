---
/**
 * Decorative "neural network" behind the hero: drifting nodes that link up
 * when close, and reach towards the visitor's finger or cursor. On first load
 * the nodes briefly gather around the headline ("focus"), then drift free.
 * ~2 KB of script, no libraries. Pauses off-screen, in background tabs and
 * for people who prefer reduced motion (they get one still frame).
 */
---

<canvas class="neural" aria-hidden="true"></canvas>

<script>
  const canvas = document.querySelector<HTMLCanvasElement>('canvas.neural');
  const ctx = canvas?.getContext('2d');
  if (canvas && ctx) {
    type Node = { x: number; y: number; vx: number; vy: number; r: number; hue: 0 | 1; a: number; ring: number; px: number; py: number };
    const reduce = matchMedia('(prefers-reduced-motion: reduce)');
    const host = canvas.parentElement as HTMLElement;
    let nodes: Node[] = [];
    let w = 0;
    let h = 0;
    let dpr = 1;
    let raf = 0;
    let visible = true;
    const pointer = { x: -9999, y: -9999, active: false };
    let mint = '124, 240, 206';
    let peri = '169, 182, 255';
    let lineAlpha = 0.18;
    // Focus intro: where the headline sits, and when the intro started.
    const focus = { x: 0, y: 0 };
    const INTRO_MS = 2600;
    let introStart = -1;

    const readColours = () => {
      const cs = getComputedStyle(document.documentElement);
      mint = cs.getPropertyValue('--mint-rgb').trim() || mint;
      peri = cs.getPropertyValue('--peri-rgb').trim() || peri;
      const light = cs.getPropertyValue('color-scheme').includes('light');
      lineAlpha = light ? 0.22 : 0.18;
    };

    const resize = () => {
      const rect = canvas.getBoundingClientRect();
      dpr = Math.min(window.devicePixelRatio || 1, 2);
      w = rect.width;
      h = rect.height;
      canvas.width = Math.round(w * dpr);
      canvas.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const target = Math.max(18, Math.min(70, Math.round((w * h) / 16000)));
      nodes = Array.from({ length: target }, () => ({
        x: Math.random() * w,
        y: Math.random() * h,
        vx: (Math.random() - 0.5) * 0.28,
        vy: (Math.random() - 0.5) * 0.28,
        r: 1.2 + Math.random() * 1.6,
        hue: Math.random() < 0.75 ? 0 : 1,
        a: Math.random() * Math.PI * 2,
        ring: 0.55 + Math.random() * 0.75,
        px: 0,
        py: 0,
      }));
      const h1 = host.querySelector('h1');
      if (h1) {
        const r = h1.getBoundingClientRect();
        focus.x = r.left + r.width / 2 - rect.left;
        focus.y = r.top + r.height / 2 - rect.top;
      } else {
        focus.x = w / 2;
        focus.y = h / 3;
      }
    };

    const link = Math.min(150, Math.max(100, window.innerWidth / 9));

    const draw = (now = 0) => {
      ctx.clearRect(0, 0, w, h);
      // Intro strength: 0 → 1 → 0 over INTRO_MS (sine ease).
      let k = 0;
      if (introStart >= 0) {
        const p = (now - introStart) / INTRO_MS;
        if (p >= 1) introStart = -1;
        else k = Math.sin(Math.PI * Math.max(0, p)) * 0.8;
      }
      const radius = Math.min(w, 900) * 0.32;
      for (const n of nodes) {
        n.x += n.vx;
        n.y += n.vy;
        if (n.x < -20) n.x = w + 20;
        if (n.x > w + 20) n.x = -20;
        if (n.y < -20) n.y = h + 20;
        if (n.y > h + 20) n.y = -20;
        if (pointer.active) {
          const dx = pointer.x - n.x;
          const dy = pointer.y - n.y;
          const d = Math.hypot(dx, dy);
          if (d < 180 && d > 0.1) {
            n.x += (dx / d) * 0.25;
            n.y += (dy / d) * 0.25;
          }
        }
      }
      for (const n of nodes) {
        const tx = focus.x + Math.cos(n.a) * radius * n.ring;
        const ty = focus.y + Math.sin(n.a) * radius * n.ring * 0.55;
        n.px = n.x + (tx - n.x) * k;
        n.py = n.y + (ty - n.y) * k;
        if (k > 0.01) {
          ctx.strokeStyle = `rgba(${n.hue ? peri : mint}, ${k * lineAlpha * 0.9})`;
          ctx.lineWidth = 1;
          ctx.beginPath();
          ctx.moveTo(n.px, n.py);
          ctx.lineTo(focus.x, focus.y);
          ctx.stroke();
        }
      }
      for (let i = 0; i < nodes.length; i++) {
        const a = nodes[i];
        for (let j = i + 1; j < nodes.length; j++) {
          const b = nodes[j];
          const d = Math.hypot(a.px - b.px, a.py - b.py);
          if (d < link) {
            ctx.strokeStyle = `rgba(${a.hue ? peri : mint}, ${(1 - d / link) * lineAlpha})`;
            ctx.lineWidth = 1;
            ctx.beginPath();
            ctx.moveTo(a.px, a.py);
            ctx.lineTo(b.px, b.py);
            ctx.stroke();
          }
        }
        if (pointer.active) {
          const d = Math.hypot(a.px - pointer.x, a.py - pointer.y);
          if (d < 180) {
            ctx.strokeStyle = `rgba(${mint}, ${(1 - d / 180) * lineAlpha * 2})`;
            ctx.beginPath();
            ctx.moveTo(a.px, a.py);
            ctx.lineTo(pointer.x, pointer.y);
            ctx.stroke();
          }
        }
      }
      for (const n of nodes) {
        ctx.fillStyle = `rgba(${n.hue ? peri : mint}, 0.75)`;
        ctx.beginPath();
        ctx.arc(n.px, n.py, n.r, 0, Math.PI * 2);
        ctx.fill();
      }
    };

    const loop = (now: number) => {
      if (introStart === -2) introStart = now;
      draw(now);
      raf = requestAnimationFrame(loop);
    };
    const start = () => {
      cancelAnimationFrame(raf);
      if (reduce.matches) draw();
      else if (visible && !document.hidden) raf = requestAnimationFrame(loop);
    };

    readColours();
    resize();
    // Play the focus intro once, only if the hero is on screen at load.
    if (!reduce.matches && canvas.getBoundingClientRect().top < window.innerHeight * 0.5) introStart = -2;
    start();

    new ResizeObserver(() => {
      resize();
      if (reduce.matches) draw();
    }).observe(canvas);
    new IntersectionObserver(([e]) => {
      visible = e.isIntersecting;
      start();
    }).observe(canvas);
    document.addEventListener('visibilitychange', start);
    reduce.addEventListener('change', start);
    // Theme switch or device theme change: pick up the new colours.
    new MutationObserver(readColours).observe(document.documentElement, { attributes: true, attributeFilter: ['data-theme'] });
    matchMedia('(prefers-color-scheme: light)').addEventListener('change', readColours);

    const move = (e: PointerEvent) => {
      const rect = canvas.getBoundingClientRect();
      pointer.x = e.clientX - rect.left;
      pointer.y = e.clientY - rect.top;
      pointer.active = pointer.y > 0 && pointer.y < rect.height;
    };
    host.addEventListener('pointermove', move, { passive: true });
    host.addEventListener('pointerdown', move, { passive: true });
    host.addEventListener('pointerleave', () => (pointer.active = false));
  }
</script>

<style>
  .neural {
    position: absolute;
    top: 0;
    left: 50%;
    width: 100vw;
    height: 100%;
    transform: translateX(-50%);
    z-index: -1;
    pointer-events: none;
    /* Fade the edges so the network melts into the page. */
    -webkit-mask-image: radial-gradient(ellipse 80% 75% at 50% 40%, #000 45%, transparent 100%);
    mask-image: radial-gradient(ellipse 80% 75% at 50% 40%, #000 45%, transparent 100%);
  }
</style>
