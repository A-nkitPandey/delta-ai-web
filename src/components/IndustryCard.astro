---
import type { CollectionEntry } from 'astro:content';
import Icon from './Icon.astro';
interface Props {
  industry: CollectionEntry<'industries'>;
}
const { industry } = Astro.props;
const d = industry.data;
---

<a href={`/industries/${industry.id}`} class="glass card">
  <span class="icon-tile"><Icon name={d.icon} size={22} /></span>
  <h3>{d.title}</h3>
  <p class="muted">{d.summary}</p>
  <span class="more">See what we build <Icon name="arrow" size={16} strokeWidth={2} /></span>
</a>

<style>
  .card {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: 26px;
    color: inherit;
    text-decoration: none;
    transition:
      border-color 0.2s,
      transform 0.2s;
  }
  .card:hover {
    border-color: rgba(var(--mint-rgb), 0.35);
    transform: translateY(-2px);
  }
  h3 {
    margin-top: 6px;
    font-size: 20px;
    letter-spacing: -0.01em;
  }
  p {
    font-size: 15px;
    line-height: 1.6;
  }
  .more {
    margin-top: auto;
    padding-top: 6px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mint);
    font-size: 14px;
    font-weight: 500;
  }
</style>
