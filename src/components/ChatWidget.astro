---
import Icon from './Icon.astro';
import { site } from '@/lib/site';
import { waLink, waNumber } from '@/lib/whatsapp';

const suggestions = ['What can you build for my business?', 'How much does a project cost?', 'Do you make WhatsApp bots?', 'Are you hiring interns?'];
---

<div class="chat" data-email={site.contact.email} data-wa={waNumber}>
  {
    waNumber && (
      <a class="wa" id="wa-float" href={waLink('Hi Delta AI! I have a question.')} target="_blank" rel="noopener" aria-label="Chat with us on WhatsApp">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true">
          <path d="M12 2a10 10 0 0 0-8.6 15.1L2 22l5-1.3A10 10 0 1 0 12 2zm0 18.2a8.2 8.2 0 0 1-4.2-1.1l-.3-.2-3 .8.8-2.9-.2-.3A8.2 8.2 0 1 1 12 20.2zm4.5-6.1c-.2-.1-1.5-.7-1.7-.8-.2-.1-.4-.1-.6.1l-.8 1c-.1.2-.3.2-.5.1a6.7 6.7 0 0 1-3.3-2.9c-.2-.4.2-.4.7-1.2.1-.2 0-.3 0-.5l-.8-1.8c-.2-.5-.4-.4-.6-.4h-.5a1 1 0 0 0-.7.3 3 3 0 0 0-.9 2.2 5.2 5.2 0 0 0 1.1 2.8 11.9 11.9 0 0 0 4.6 4c1.7.7 2.4.8 3.2.7a2.8 2.8 0 0 0 1.8-1.3 2.3 2.3 0 0 0 .2-1.3c-.1-.1-.3-.2-.5-.3z" />
        </svg>
      </a>
    )
  }
  <button type="button" class="launcher" id="chat-open" aria-haspopup="dialog" aria-controls="chat-panel" aria-expanded="false">
    <span class="pulse" aria-hidden="true"></span>
    <Icon name="chat" size={20} strokeWidth={2} />
    <span class="ltxt">Ask Delta AI</span>
    <span class="badge" id="chat-badge" aria-hidden="true" hidden>1</span>
  </button>

  <div class="nudge" id="chat-nudge" hidden>
    <button type="button" class="ntext" id="chat-nudge-open">
      <span class="nwho">Delta AI</span>
      Hi! 👋 Want to see how AI can answer your customers on WhatsApp — even at midnight?
    </button>
    <button type="button" class="nx" id="chat-nudge-x" aria-label="Dismiss message">
      <Icon name="close" size={14} strokeWidth={2} />
    </button>
  </div>

  <section id="chat-panel" class="panel" role="dialog" aria-modal="false" aria-labelledby="chat-title" hidden>
    <header class="top">
      <span class="avatar" aria-hidden="true">
        <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linejoin="round"><path d="M12 3 L21.5 20 H2.5 Z"></path><path d="M12 10 L16 17 H8 Z"></path></svg>
      </span>
      <div class="who">
        <h2 id="chat-title">Delta AI assistant</h2>
        <p><span class="dot" aria-hidden="true"></span>Replies in seconds · AI can make mistakes</p>
      </div>
      <button type="button" class="x" id="chat-close" aria-label="Close chat">
        <Icon name="close" size={18} strokeWidth={2} />
      </button>
    </header>

    <div class="log" id="chat-log" role="log" aria-live="polite">
      <div class="msg bot">Hi! I’m Delta’s AI assistant. Ask me about our services, industries, how we work or internships.</div>
      <div class="chips" id="chat-chips">
        {suggestions.map((s) => <button type="button" class="chipbtn">{s}</button>)}
      </div>
    </div>

    <div class="share" id="chat-share" hidden>
      {
        waNumber && (
          <button type="button" class="btn btn--primary btn--sm btn--block" id="chat-wa">
            <Icon name="whatsapp" size={16} strokeWidth={2} /> Continue on WhatsApp
          </button>
        )
      }
      <button type="button" class:list={['btn', 'btn--sm', 'btn--block', waNumber ? 'btn--ghost' : 'btn--primary']} id="chat-handoff">
        Share with our team <Icon name="arrow" size={16} strokeWidth={2} />
      </button>
    </div>

    <form class="bar" id="chat-form" autocomplete="off">
      <label for="chat-input" class="sr-only">Your question</label>
      <input id="chat-input" name="q" type="text" maxlength="600" placeholder="Type your question…" required />
      <button type="submit" class="send" id="chat-send" aria-label="Send">
        <Icon name="send" size={18} strokeWidth={2} />
      </button>
    </form>
  </section>
</div>

<script>
  type Msg = { role: 'user' | 'assistant'; content: string };

  const root = document.querySelector<HTMLElement>('.chat');
  if (root) {
    const openBtn = document.getElementById('chat-open') as HTMLButtonElement;
    const closeBtn = document.getElementById('chat-close') as HTMLButtonElement;
    const panel = document.getElementById('chat-panel') as HTMLElement;
    const log = document.getElementById('chat-log') as HTMLElement;
    const chips = document.getElementById('chat-chips') as HTMLElement | null;
    const form = document.getElementById('chat-form') as HTMLFormElement;
    const input = document.getElementById('chat-input') as HTMLInputElement;
    const send = document.getElementById('chat-send') as HTMLButtonElement;
    const share = document.getElementById('chat-share') as HTMLElement;
    const handoff = document.getElementById('chat-handoff') as HTMLButtonElement;
    const email = root.dataset.email ?? '';
    const history: Msg[] = [];
    let busy = false;

    const nudge = document.getElementById('chat-nudge') as HTMLElement;
    const badge = document.getElementById('chat-badge') as HTMLElement;
    const NUDGE_KEY = 'delta-chat-nudged';
    const hideNudge = () => {
      nudge.hidden = true;
      badge.hidden = true;
      try {
        sessionStorage.setItem(NUDGE_KEY, '1');
      } catch {
        /* storage unavailable: the nudge may show again next page */
      }
    };

    const setOpen = (open: boolean) => {
      if (open) hideNudge();
      panel.hidden = !open;
      root.classList.toggle('is-open', open);
      openBtn.setAttribute('aria-expanded', String(open));
      if (open) setTimeout(() => input.focus(), 50);
      else openBtn.focus();
    };
    openBtn.addEventListener('click', () => setOpen(panel.hidden === true));

    // A friendly greeting once per visit, a few seconds after the page settles.
    let seen = false;
    try {
      seen = sessionStorage.getItem(NUDGE_KEY) === '1';
    } catch {
      seen = false;
    }
    if (!seen) {
      window.setTimeout(() => {
        if (panel.hidden !== true || document.visibilityState !== 'visible') return;
        nudge.hidden = false;
        badge.hidden = false;
        window.setTimeout(() => {
          if (!nudge.hidden) nudge.hidden = true;
        }, 15000);
      }, 6000);
    }
    document.getElementById('chat-nudge-open')?.addEventListener('click', () => setOpen(true));
    document.getElementById('chat-nudge-x')?.addEventListener('click', hideNudge);
    closeBtn.addEventListener('click', () => setOpen(false));
    document.addEventListener('keydown', (e) => {
      if (e.key === 'Escape' && !panel.hidden) setOpen(false);
    });

    /** Render text safely: plain text with links for our own pages, emails and URLs. */
    const linkify = (el: HTMLElement, text: string) => {
      const re = /(https?:\/\/[^\s)]+|[\w.+-]+@[\w-]+\.[\w.]+|\/(?:careers|partners|work|industries(?:\/[\w-]+)?|services(?:\/[\w-]+)?|about|#contact|#pricing))/g;
      let last = 0;
      for (const m of text.matchAll(re)) {
        const i = m.index ?? 0;
        if (i > last) el.appendChild(document.createTextNode(text.slice(last, i)));
        const raw = m[0].replace(/[.,]$/, '');
        const a = document.createElement('a');
        a.textContent = raw;
        if (raw.includes('@') && !raw.startsWith('http')) a.href = `mailto:${raw}`;
        else if (raw.startsWith('/')) a.href = raw;
        else {
          a.href = raw;
          a.rel = 'noopener nofollow';
          a.target = '_blank';
        }
        el.appendChild(a);
        if (raw.length < m[0].length) el.appendChild(document.createTextNode(m[0].slice(raw.length)));
        last = i + m[0].length;
      }
      if (last < text.length) el.appendChild(document.createTextNode(text.slice(last)));
    };

    const add = (role: 'user' | 'bot' | 'err', text: string) => {
      const div = document.createElement('div');
      div.className = `msg ${role}`;
      if (role === 'user') div.textContent = text;
      else linkify(div, text);
      log.appendChild(div);
      log.scrollTop = log.scrollHeight;
      return div;
    };

    const ask = async (q: string) => {
      const text = q.trim().slice(0, 600);
      if (!text || busy) return;
      busy = true;
      send.disabled = true;
      chips?.remove();
      add('user', text);
      history.push({ role: 'user', content: text });
      input.value = '';

      const typing = document.createElement('div');
      typing.className = 'msg bot typing';
      typing.setAttribute('aria-label', 'Assistant is typing');
      typing.innerHTML = '<span></span><span></span><span></span>';
      log.appendChild(typing);
      log.scrollTop = log.scrollHeight;

      try {
        const res = await fetch('/api/chat', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify({ messages: history.slice(-8) }),
        });
        const body = (await res.json().catch(() => ({}))) as { reply?: string; message?: string };
        typing.remove();
        if (res.ok && body.reply) {
          add('bot', body.reply);
          history.push({ role: 'assistant', content: body.reply });
          share.hidden = false;
        } else {
          add('err', body.message ?? `Sorry, something went wrong. Please email us at ${email}.`);
          history.pop();
        }
      } catch {
        typing.remove();
        add('err', 'Network error — please check your connection and try again.');
        history.pop();
      } finally {
        busy = false;
        send.disabled = false;
        input.focus();
      }
    };

    form.addEventListener('submit', (e) => {
      e.preventDefault();
      ask(input.value);
    });
    chips?.querySelectorAll<HTMLButtonElement>('.chipbtn').forEach((b) => b.addEventListener('click', () => ask(b.textContent ?? '')));

    // WhatsApp: the floating button says which page the visitor was on, and the chat
    // can continue on WhatsApp carrying the questions already asked.
    const wa = root.dataset.wa ?? '';
    const waUrl = (text: string) => `https://wa.me/${wa}?text=${encodeURIComponent(text)}`;
    const waFloat = document.getElementById('wa-float') as HTMLAnchorElement | null;
    if (waFloat && wa) {
      const page = location.pathname === '/' ? 'your website' : `this page: ${location.origin}${location.pathname}`;
      waFloat.href = waUrl(`Hi Delta AI! I was looking at ${page} and have a question.`);
    }
    document.getElementById('chat-wa')?.addEventListener('click', () => {
      const asked = history.filter((m) => m.role === 'user').map((m) => `- ${m.content}`);
      const text = `Hi Delta AI! I was chatting with your website assistant. My questions:\n${asked.join('\n')}`.slice(0, 1500);
      window.open(waUrl(text), '_blank', 'noopener');
    });

    // Hand the visitor's questions to the contact form so they don't retype them.
    handoff.addEventListener('click', () => {
      const asked = history.filter((m) => m.role === 'user').map((m) => `- ${m.content}`);
      const note = `From the website chat:\n${asked.join('\n')}`.slice(0, 3900);
      const box = document.getElementById('f-msg') as HTMLTextAreaElement | null;
      if (box) {
        if (!box.value.trim()) box.value = note;
        setOpen(false);
        document.getElementById('contact')?.scrollIntoView({ behavior: 'smooth' });
        setTimeout(() => (document.getElementById('f-name') as HTMLInputElement | null)?.focus({ preventScroll: true }), 400);
      } else {
        try {
          sessionStorage.setItem('delta-chat-note', note);
        } catch {
          /* storage unavailable: the form simply starts empty */
        }
        location.href = '/#contact';
      }
    });
  }
</script>

<style>
  .chat {
    position: fixed;
    right: max(16px, env(safe-area-inset-right));
    bottom: max(16px, env(safe-area-inset-bottom));
    z-index: 60;
    display: flex;
    align-items: flex-end;
    gap: 10px;
  }
  .wa {
    flex: none;
    width: 52px;
    height: 52px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    background: #25d366;
    color: #fff;
    box-shadow: 0 14px 40px rgba(var(--shadow-rgb), 0.45);
    transition: transform 0.2s;
  }
  .wa:hover {
    transform: translateY(-2px);
  }
  .is-open .wa {
    display: none;
  }
  .launcher {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 52px;
    padding: 0 20px 0 16px;
    border-radius: 999px;
    border: 1px solid rgba(var(--mint-rgb), 0.5);
    background: var(--mint);
    color: var(--mint-ink);
    font-weight: 600;
    font-size: 15px;
    cursor: pointer;
    box-shadow:
      0 14px 40px rgba(var(--shadow-rgb), 0.45),
      0 0 0 6px rgba(var(--mint-rgb), 0.08);
    transition: transform 0.2s;
  }
  .launcher:hover {
    transform: translateY(-2px);
  }
  .pulse {
    position: absolute;
    inset: -1px;
    border-radius: inherit;
    border: 2px solid rgba(var(--mint-rgb), 0.6);
    animation: ring 2.8s ease-out infinite;
    pointer-events: none;
  }
  @keyframes ring {
    0% {
      opacity: 0.9;
      transform: scale(1);
    }
    70%,
    100% {
      opacity: 0;
      transform: scale(1.25);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .pulse {
      animation: none;
      opacity: 0;
    }
  }
  .is-open .launcher {
    display: none;
  }
  .badge {
    position: absolute;
    top: -6px;
    right: -4px;
    min-width: 20px;
    height: 20px;
    padding: 0 5px;
    border-radius: 999px;
    display: grid;
    place-items: center;
    background: #ef4444;
    color: #fff;
    font-size: 11px;
    font-weight: 700;
    border: 2px solid var(--ink);
    animation: pop-in 0.35s cubic-bezier(0.22, 1, 0.36, 1);
  }
  .badge[hidden],
  .nudge[hidden] {
    display: none;
  }
  .nudge {
    position: absolute;
    right: 0;
    bottom: calc(100% + 12px);
    width: min(290px, calc(100vw - 32px));
    display: flex;
    align-items: flex-start;
    gap: 4px;
    padding: 12px 8px 12px 14px;
    border-radius: 18px;
    border-bottom-right-radius: 6px;
    background: var(--ink-2);
    border: 1px solid rgba(var(--mint-rgb), 0.3);
    box-shadow: 0 18px 48px rgba(var(--shadow-rgb), 0.45);
    animation: pop-in 0.45s cubic-bezier(0.22, 1, 0.36, 1);
    transform-origin: bottom right;
  }
  .ntext {
    flex: 1;
    text-align: left;
    background: none;
    border: 0;
    color: var(--text);
    font-size: 14px;
    line-height: 1.45;
    cursor: pointer;
    padding: 0;
  }
  .nwho {
    display: block;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    color: var(--mint);
    margin-bottom: 4px;
  }
  .nx {
    flex: none;
    width: 32px;
    height: 32px;
    display: grid;
    place-items: center;
    border-radius: 999px;
    border: 0;
    background: transparent;
    color: var(--faint);
    cursor: pointer;
  }
  .nx:hover {
    background: rgba(var(--fg-rgb), 0.06);
    color: var(--text);
  }
  @keyframes pop-in {
    from {
      opacity: 0;
      transform: translateY(8px) scale(0.92);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .badge,
    .nudge {
      animation: none;
    }
  }
  .panel {
    width: min(390px, calc(100vw - 32px));
    height: min(600px, calc(100dvh - 32px));
    display: flex;
    flex-direction: column;
    border-radius: 24px;
    overflow: hidden;
    background: var(--ink-2);
    border: 1px solid rgba(var(--fg-rgb), 0.12);
    box-shadow: 0 30px 90px rgba(var(--shadow-rgb), 0.6);
    backdrop-filter: blur(20px);
    -webkit-backdrop-filter: blur(20px);
  }
  .panel[hidden] {
    display: none;
  }
  .top {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 16px 16px 14px;
    border-bottom: 1px solid rgba(var(--fg-rgb), 0.08);
    background: linear-gradient(135deg, rgba(var(--mint-rgb), 0.1), transparent 70%);
  }
  .avatar {
    flex: none;
    display: inline-flex;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    color: var(--mint);
    background: rgba(var(--mint-rgb), 0.12);
    border: 1px solid rgba(var(--mint-rgb), 0.35);
  }
  .who {
    flex: 1;
    min-width: 0;
  }
  .who h2 {
    font-size: 15px;
    letter-spacing: -0.01em;
  }
  .who p {
    margin-top: 2px;
    display: flex;
    align-items: center;
    gap: 6px;
    font-size: 12px;
    color: var(--faint);
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 8px var(--mint);
  }
  .x {
    flex: none;
    display: inline-flex;
    width: 40px;
    height: 40px;
    border-radius: 12px;
    align-items: center;
    justify-content: center;
    background: rgba(var(--fg-rgb), 0.05);
    border: 1px solid rgba(var(--fg-rgb), 0.1);
    color: var(--text-2);
    cursor: pointer;
  }
  .log {
    flex: 1;
    overflow-y: auto;
    padding: 16px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    overscroll-behavior: contain;
  }
  .log :global(.msg) {
    max-width: 88%;
    padding: 10px 14px;
    border-radius: 16px;
    font-size: 14.5px;
    line-height: 1.55;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .log :global(.msg a) {
    color: var(--mint);
  }
  .log :global(.bot) {
    align-self: flex-start;
    background: rgba(var(--fg-rgb), 0.06);
    border: 1px solid rgba(var(--fg-rgb), 0.08);
    border-bottom-left-radius: 6px;
  }
  .log :global(.user) {
    align-self: flex-end;
    background: rgba(var(--mint-rgb), 0.16);
    border: 1px solid rgba(var(--mint-rgb), 0.3);
    border-bottom-right-radius: 6px;
  }
  .log :global(.err) {
    align-self: flex-start;
    background: rgba(var(--danger-rgb), 0.08);
    border: 1px solid rgba(var(--danger-rgb), 0.25);
    color: var(--danger);
  }
  .log :global(.typing) {
    display: inline-flex;
    gap: 5px;
    padding: 14px 16px;
  }
  .log :global(.typing span) {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--text-2);
    animation: blink 1.2s infinite ease-in-out;
  }
  .log :global(.typing span:nth-child(2)) {
    animation-delay: 0.2s;
  }
  .log :global(.typing span:nth-child(3)) {
    animation-delay: 0.4s;
  }
  @keyframes blink {
    0%,
    80%,
    100% {
      opacity: 0.25;
    }
    40% {
      opacity: 1;
    }
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 4px;
  }
  .chipbtn {
    min-height: 36px;
    padding: 6px 12px;
    border-radius: 999px;
    background: transparent;
    border: 1px solid rgba(var(--mint-rgb), 0.35);
    color: var(--mint);
    font-size: 13px;
    cursor: pointer;
    text-align: left;
  }
  .chipbtn:hover {
    background: rgba(var(--mint-rgb), 0.08);
  }
  .share {
    padding: 0 16px 10px;
    display: flex;
    flex-direction: column;
    gap: 8px;
  }
  .share .btn {
    gap: 8px;
  }
  .share[hidden] {
    display: none;
  }
  .bar {
    display: flex;
    gap: 8px;
    padding: 12px;
    border-top: 1px solid rgba(var(--fg-rgb), 0.08);
  }
  .bar input {
    flex: 1;
    min-width: 0;
    min-height: 46px;
    padding: 0 14px;
    border-radius: 14px;
    background: rgba(var(--base-rgb), 0.7);
    border: 1px solid rgba(var(--fg-rgb), 0.12);
    color: var(--text);
    font-size: 16px;
  }
  .bar input:focus {
    outline: none;
    border-color: var(--mint);
  }
  .send {
    flex: none;
    width: 46px;
    height: 46px;
    border-radius: 14px;
    display: inline-flex;
    align-items: center;
    justify-content: center;
    background: var(--mint);
    color: var(--mint-ink);
    border: 0;
    cursor: pointer;
  }
  .send:disabled {
    opacity: 0.6;
    cursor: progress;
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
  @media (max-width: 560px) {
    .ltxt {
      font-size: 14px;
    }
    .launcher {
      min-height: 48px;
      padding: 0 16px 0 14px;
    }
    .wa {
      width: 48px;
      height: 48px;
    }
  }
</style>
