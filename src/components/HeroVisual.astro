---
import Icon from './Icon.astro';
/* Illustrative live-queue card based on the Salon Token product. */
---

<div class="stage" aria-hidden="true">
  <div class="card">
    <div class="top">
      <div class="who">
        <span class="badge"><Icon name="scissors" size={18} strokeWidth={2} /></span>
        <div>
          <div class="t">Salon Token</div>
          <div class="mono">khanpopular.online</div>
        </div>
      </div>
      <span class="live"><span class="dot"></span>Live queue</span>
    </div>
    <!-- A 10-second looping story: a customer asks on WhatsApp, the AI books a token. Pure CSS. -->
    <div class="convo">
      <div class="who-line"><span class="wa"></span>WhatsApp · AI assistant</div>
      <div class="bubble in b1">Kitna wait hai? 2 log, haircut 💇</div>
      <div class="bubble out typing-b"><span></span><span></span><span></span></div>
      <div class="bubble out b2">~25 min. Token <b>#17</b> booked ✅ We’ll ping you 10 min before.</div>
    </div>
    <div class="panel">
      <div class="mono label">NOW SERVING</div>
      <div class="serving"><span class="num">#14</span><span class="muted small mine">Your token: <b>#17</b></span></div>
      <div class="track"><div class="fill"></div></div>
      <div class="row small"><span class="muted">Approx. wait</span><span>~ 25 min</span></div>
    </div>
    <div class="mini">
      <div class="tile"><div class="small faint">Next up</div><b>#15 · #16</b></div>
      <div class="tile"><div class="small faint">Arrive by</div><b>11:40 AM</b></div>
    </div>
    <div class="float float--a"><Icon name="shield" size={18} strokeWidth={2} class="c-mint" />Secure payments · spam-protected</div>
  </div>
</div>

<style>
  .stage {
    position: relative;
    display: flex;
    justify-content: center;
    padding: 28px 0;
  }
  .card {
    position: relative;
    width: 100%;
    max-width: 460px;
    padding: 22px;
    border-radius: 28px;
    background: linear-gradient(180deg, rgba(var(--fg-rgb), 0.08), rgba(var(--fg-rgb), 0.02));
    border: 1px solid rgba(var(--fg-rgb), 0.12);
    backdrop-filter: blur(24px);
    -webkit-backdrop-filter: blur(24px);
    box-shadow: 0 40px 120px rgba(var(--shadow-rgb), 0.55), inset 0 1px 0 rgba(var(--fg-rgb), 0.12);
  }
  .top,
  .who,
  .row,
  .serving {
    display: flex;
    align-items: center;
    gap: 10px;
  }
  .top,
  .row {
    justify-content: space-between;
  }
  .badge {
    display: inline-flex;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    color: var(--peri);
    background: rgba(var(--peri-rgb), 0.15);
    border: 1px solid rgba(var(--peri-rgb), 0.3);
  }
  .t {
    font-weight: 600;
    font-size: 15px;
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 11px;
    color: var(--faint);
  }
  .label {
    letter-spacing: 0.08em;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 5px 10px;
    border-radius: 999px;
    background: rgba(var(--mint-rgb), 0.12);
    color: var(--mint);
    font-size: 12px;
    font-weight: 500;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 10px var(--mint);
    animation: pulse 2s ease-in-out infinite;
  }
  @keyframes pulse {
    50% {
      opacity: 0.35;
    }
  }
  .panel {
    margin-top: 20px;
    padding: 20px;
    border-radius: 18px;
    background: rgba(var(--base-rgb), 0.55);
    border: 1px solid rgba(var(--fg-rgb), 0.07);
  }
  .serving {
    align-items: baseline;
    gap: 12px;
    margin-top: 6px;
  }
  .num {
    font-size: 56px;
    font-weight: 600;
    letter-spacing: -0.04em;
    line-height: 1.1;
  }
  .small {
    font-size: 13px;
  }
  .faint {
    color: var(--faint);
  }
  b {
    font-weight: 600;
    color: var(--text);
  }
  .track {
    margin: 14px 0 10px;
    height: 8px;
    border-radius: 99px;
    background: rgba(var(--fg-rgb), 0.07);
    overflow: hidden;
  }
  .fill {
    width: 62%;
    height: 100%;
    border-radius: 99px;
    background: linear-gradient(90deg, var(--peri), var(--mint));
  }
  .mini {
    margin-top: 14px;
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 10px;
  }
  .tile {
    padding: 14px;
    border-radius: 14px;
    background: rgba(var(--fg-rgb), 0.04);
    border: 1px solid rgba(var(--fg-rgb), 0.07);
  }
  .float {
    position: absolute;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 12px 16px;
    border-radius: 16px;
    background: rgba(var(--surface-rgb), 0.85);
    border: 1px solid rgba(var(--fg-rgb), 0.12);
    backdrop-filter: blur(16px);
    -webkit-backdrop-filter: blur(16px);
    box-shadow: 0 16px 40px rgba(var(--shadow-rgb), 0.45);
    font-size: 13px;
    white-space: nowrap;
  }
  .float--a {
    left: -28px;
    bottom: -22px;
  }
  .float--b {
    right: -20px;
    top: -22px;
  }
  .float :global(.c-mint) {
    color: var(--mint);
  }
  .float :global(.c-peri) {
    color: var(--peri);
  }
  @media (max-width: 560px) {
    .float--a {
      left: 8px;
    }
    .float {
      font-size: 12px;
      padding: 10px 14px;
    }
    .float--b {
      right: 8px;
      top: -36px;
    }
  }
  /* ---------- WhatsApp → AI → token story (10s loop) ---------- */
  .convo {
    position: relative;
    height: 128px;
    margin-top: 16px;
    padding: 12px;
    border-radius: 16px;
    background: rgba(var(--base-rgb), 0.45);
    border: 1px solid rgba(var(--fg-rgb), 0.07);
    overflow: hidden;
  }
  .who-line {
    display: flex;
    align-items: center;
    gap: 6px;
    font-family: var(--font-mono);
    font-size: 10.5px;
    letter-spacing: 0.04em;
    color: var(--faint);
  }
  .wa {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: #25d366;
  }
  .bubble {
    position: absolute;
    max-width: 82%;
    padding: 7px 11px;
    border-radius: 14px;
    font-size: 12.5px;
    line-height: 1.4;
    opacity: 0;
  }
  .bubble.in {
    left: 12px;
    top: 34px;
    background: rgba(var(--fg-rgb), 0.08);
    border-bottom-left-radius: 4px;
  }
  .bubble.out {
    right: 12px;
    top: 72px;
    background: rgba(var(--mint-rgb), 0.16);
    border: 1px solid rgba(var(--mint-rgb), 0.3);
    border-bottom-right-radius: 4px;
  }
  .typing-b {
    display: inline-flex;
    gap: 4px;
    padding: 10px 12px;
  }
  .typing-b span {
    width: 5px;
    height: 5px;
    border-radius: 50%;
    background: var(--text-2);
    animation: tdot 1s infinite ease-in-out;
  }
  .typing-b span:nth-child(2) {
    animation-delay: 0.15s;
  }
  .typing-b span:nth-child(3) {
    animation-delay: 0.3s;
  }
  @keyframes tdot {
    0%,
    100% {
      opacity: 0.3;
    }
    50% {
      opacity: 1;
    }
  }
  @media (prefers-reduced-motion: no-preference) {
    .b1 {
      animation: s-b1 10s infinite;
    }
    .typing-b {
      animation: s-typing 10s infinite;
    }
    .b2 {
      animation: s-b2 10s infinite;
    }
    .mine b {
      animation: s-mine 10s infinite;
    }
    .fill {
      animation: s-fill 10s infinite;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .b1,
    .b2 {
      opacity: 1;
    }
  }
  @keyframes s-b1 {
    0%,
    6% {
      opacity: 0;
      transform: translateY(8px);
    }
    10%,
    90% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes s-typing {
    0%,
    16% {
      opacity: 0;
    }
    18%,
    30% {
      opacity: 1;
    }
    32%,
    100% {
      opacity: 0;
    }
  }
  @keyframes s-b2 {
    0%,
    31% {
      opacity: 0;
      transform: translateY(8px);
    }
    35%,
    90% {
      opacity: 1;
      transform: none;
    }
    96%,
    100% {
      opacity: 0;
    }
  }
  @keyframes s-mine {
    0%,
    34% {
      color: var(--text);
      text-shadow: none;
    }
    38%,
    60% {
      color: var(--mint);
      text-shadow: 0 0 12px rgba(var(--mint-rgb), 0.7);
    }
    70%,
    100% {
      color: var(--text);
      text-shadow: none;
    }
  }
  @keyframes s-fill {
    0%,
    40% {
      width: 55%;
    }
    60%,
    92% {
      width: 66%;
    }
    100% {
      width: 55%;
    }
  }
</style>
