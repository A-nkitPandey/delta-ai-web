---
import { getCollection } from 'astro:content';
import { site } from '@/lib/site';
import Icon from './Icon.astro';
import HeroVisual from './HeroVisual.astro';
import NeuralField from './NeuralField.astro';
const { hero, stack } = site;

// While any role on /careers is open, the hiring banner replaces the usual announcement.
const openJobs = await getCollection('jobs', ({ data }) => data.open);
const announcement =
  site.hiring?.show && openJobs.length > 0 ? { label: site.hiring.label, text: site.hiring.text, href: '/careers' } : site.announcement;

// Trust strip: facts a visitor can check.
const liveWork = (await getCollection('work', ({ data }) => !data.draft && !!data.url)).sort((a, b) => a.data.order - b.data.order)[0];
const trust = [
  site.udyam && { icon: 'shield', title: 'MSME registered', text: site.udyam },
  { icon: 'check', title: `Based in ${site.contact.city.split(',')[0]}`, text: 'Working with clients across India' },
  liveWork && { icon: 'spark', title: `Live client: ${liveWork.data.client}`, text: liveWork.data.url!.replace(/^https?:\/\//, ''), href: liveWork.data.url },
  { icon: 'cloud', title: 'You own everything', text: 'Code, domain and accounts in your name' },
].filter(Boolean) as { icon: string; title: string; text: string; href?: string }[];
---

<section class="hero wrap" aria-labelledby="hero-title">
  <NeuralField />
  <div class="copy">
    {
      announcement && (
        <a class="pill" href={announcement.href}>
          <span class="chip chip--mint mono">{announcement.label}</span>
          {announcement.text}
        </a>
      )
    }
    <h1 id="hero-title">
      {hero.before}{' '}
      <span class="accent accent--mint rot" data-words={JSON.stringify(hero.rotate)}>
        <span class="sr-only">{hero.accent}</span><span class="rot-text" aria-hidden="true">{hero.accent}</span><span class="caret" aria-hidden="true"></span>
      </span>{hero.after}
    </h1>
    <p class="lead intro">{hero.intro}</p>
    <div class="ctas">
      <a href="/#contact" class="btn btn--primary">{hero.primaryCta}<Icon name="arrow" size={18} strokeWidth={2} /></a>
      <a href="/#work" class="btn btn--ghost">{hero.secondaryCta}</a>
    </div>
    <ul class="stack" aria-label="Works with the tools you already use">
      <li class="faint">WORKS WITH</li>
      {stack.map((s) => <li>{s}</li>)}
    </ul>
  </div>
  <div class="visual">
    <HeroVisual />
  </div>
</section>

<section class="trust" aria-label="Why you can trust us">
  <ul class="wrap row">
    {
      trust.map((t) => (
        <li>
          <span class="ti">
            <Icon name={t.icon} size={18} strokeWidth={2} />
          </span>
          <span class="tt">
            <b>{t.title}</b>
            {t.href ? (
              <a href={t.href} rel="noopener" target="_blank">
                {t.text}
              </a>
            ) : (
              <span>{t.text}</span>
            )}
          </span>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 56px;
    padding-top: clamp(56px, 9vw, 96px);
    padding-bottom: 72px;
  }
  .copy {
    flex: 1 1 520px;
    min-width: 0;
  }
  .visual {
    flex: 1 1 400px;
    min-width: 0;
  }
  .pill {
    display: inline-flex;
    align-items: center;
    gap: 10px;
    min-height: 36px;
    padding: 4px 14px 4px 6px;
    border-radius: 999px;
    background: rgba(var(--fg-rgb), 0.04);
    border: 1px solid rgba(var(--fg-rgb), 0.1);
    font-size: 13px;
    color: var(--text-2);
    text-decoration: none;
  }
  .pill:hover {
    color: var(--text);
    border-color: var(--edge-2);
  }
  .mono {
    font-family: var(--font-mono);
    font-size: 11px;
    letter-spacing: 0.04em;
  }
  h1 {
    margin-top: 28px;
    font-size: clamp(40px, 6vw, 76px);
    line-height: 1.02;
    letter-spacing: -0.035em;
  }
  .intro {
    margin-top: 24px;
    max-width: 560px;
  }
  .ctas {
    margin-top: 36px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
  .stack {
    margin-top: 44px;
    display: flex;
    flex-wrap: wrap;
    gap: 8px 20px;
    list-style: none;
    font-family: var(--font-mono);
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--text-2);
  }
  .faint {
    color: var(--faint);
  }
  .trust {
    border-block: 1px solid rgba(var(--fg-rgb), 0.06);
    background: rgba(var(--fg-rgb), 0.015);
  }
  .row {
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(230px, 100%), 1fr));
    gap: 18px 32px;
    padding-block: 26px;
  }
  .trust li {
    display: flex;
    align-items: center;
    gap: 12px;
    min-width: 0;
  }
  .ti {
    flex: none;
    display: inline-flex;
    width: 36px;
    height: 36px;
    border-radius: 10px;
    align-items: center;
    justify-content: center;
    color: var(--mint);
    background: rgba(var(--mint-rgb), 0.08);
    border: 1px solid rgba(var(--mint-rgb), 0.22);
  }
  .tt {
    display: flex;
    flex-direction: column;
    min-width: 0;
    font-size: 13px;
    color: var(--faint);
  }
  .tt b {
    font-size: 14px;
    font-weight: 600;
    color: var(--text);
  }
  .tt a {
    color: var(--text-2);
    text-decoration: underline;
    text-decoration-color: rgba(var(--fg-rgb), 0.2);
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }
  @media (max-width: 560px) {
    .ctas .btn {
      width: 100%;
    }
  }
  .caret {
    display: none;
    width: 0.06em;
    height: 0.85em;
    margin-left: 0.04em;
    vertical-align: -0.05em;
    background: currentColor;
    animation: blink-caret 1s steps(1) infinite;
  }
  .rot.typing .caret {
    display: inline-block;
  }
  @keyframes blink-caret {
    50% {
      opacity: 0;
    }
  }
  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
  }
</style>

<script>
  // Type out the hero's accent word: thinks → talks → sells → scales.
  const rot = document.querySelector<HTMLElement>('.rot');
  const out = rot?.querySelector<HTMLElement>('.rot-text');
  const words: string[] = rot ? JSON.parse(rot.dataset.words || '[]') : [];
  if (rot && out && words.length > 1 && !matchMedia('(prefers-reduced-motion: reduce)').matches) {
    rot.classList.add('typing');
    let i = 0;
    const wait = (ms: number) => new Promise((r) => setTimeout(r, ms));
    const run = async () => {
      for (;;) {
        await wait(2400);
        const word = out.textContent ?? '';
        for (let n = word.length; n > 0; n--) {
          out.textContent = word.slice(0, n - 1);
          await wait(45);
        }
        i = (i + 1) % words.length;
        for (let n = 1; n <= words[i].length; n++) {
          out.textContent = words[i].slice(0, n);
          await wait(85);
        }
      }
    };
    run();
  }
</script>
