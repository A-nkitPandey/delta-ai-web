---
import BaseLayout from '@/layouts/BaseLayout.astro';
---

<BaseLayout title="Page not found" description="The page you were looking for doesn't exist." noindex>
  <section class="wrap nf">
    <p class="eyebrow">404</p>
    <h1>This page took a <span class="accent accent--mint">different path</span>.</h1>
    <p class="lead">The link may be old or mistyped. Let’s get you back on track.</p>
    <div class="ctas">
      <a href="/" class="btn btn--primary">Go home</a>
      <a href="/services" class="btn btn--ghost">See services</a>
    </div>
  </section>
</BaseLayout>

<style>
  .nf {
    min-height: 60vh;
    padding-top: clamp(64px, 12vw, 140px);
  }
  h1 {
    margin-top: 14px;
    font-size: clamp(36px, 5vw, 60px);
    max-width: 760px;
  }
  .lead {
    margin-top: 18px;
  }
  .ctas {
    margin-top: 32px;
    display: flex;
    flex-wrap: wrap;
    gap: 12px;
  }
</style>
