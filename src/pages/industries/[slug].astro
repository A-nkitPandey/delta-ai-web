---
import { getCollection, getEntry, type CollectionEntry } from 'astro:content';
import BaseLayout from '@/layouts/BaseLayout.astro';
import Breadcrumbs from '@/components/Breadcrumbs.astro';
import Icon from '@/components/Icon.astro';
import ServiceCard from '@/components/ServiceCard.astro';
import IndustryCard from '@/components/IndustryCard.astro';
import ContactSection from '@/components/ContactSection.astro';
import { site } from '@/lib/site';

export async function getStaticPaths() {
  const industries = await getCollection('industries', ({ data }) => !data.draft);
  return industries.map((industry) => ({ params: { slug: industry.id }, props: { industry } }));
}

interface Props {
  industry: CollectionEntry<'industries'>;
}
const { industry } = Astro.props;
const d = industry.data;

const services = (await Promise.all(d.services.map((id) => getEntry('services', id)))).filter(
  (s): s is CollectionEntry<'services'> => !!s && !s.data.draft,
);
const work = d.work ? await getEntry('work', d.work) : undefined;
const others = (await getCollection('industries', ({ data, id }) => !data.draft && id !== industry.id)).sort((a, b) => a.data.order - b.data.order);
const ctaService = services[0]?.id ?? 'other';
const shortName = d.title.split(' & ')[0].toLowerCase().replace(/s$/, '');

const jsonLd = [
  {
    '@type': 'Service',
    name: `Software for ${d.title.toLowerCase()}`,
    description: d.summary,
    audience: { '@type': 'BusinessAudience', audienceType: d.title },
    areaServed: { '@type': 'Country', name: 'India' },
    provider: { '@id': new URL('/#organization', Astro.site).href, name: site.name },
    url: new URL(`/industries/${industry.id}`, Astro.site).href,
  },
];
---

<BaseLayout title={d.seo?.title ?? `Software for ${d.title}`} description={d.seo?.description ?? d.summary} jsonLd={jsonLd}>
  <article class="wrap page">
    <Breadcrumbs items={[{ name: 'Industries', href: '/industries' }, { name: d.title, href: `/industries/${industry.id}` }]} />
    <header class="head">
      <span class="icon-tile big"><Icon name={d.icon} size={26} /></span>
      <p class="eyebrow">{d.title}</p>
      <h1>{d.headline}</h1>
      <p class="lead">{d.summary}</p>
      <div class="ctas">
        <a href={`/?service=${ctaService}#contact`} class="btn btn--primary">Discuss your {shortName} project<Icon name="arrow" size={18} strokeWidth={2} /></a>
      </div>
    </header>

    {
      d.problems.length > 0 && (
        <section class="block" aria-labelledby="pain-title">
          <h2 id="pain-title" class="eyebrow">Sound familiar?</h2>
          <ul class="pains">
            {d.problems.map((p) => (
              <li class="glass">{p}</li>
            ))}
          </ul>
        </section>
      )
    }

    <section class="block" aria-labelledby="fix-title">
      <h2 id="fix-title" class="eyebrow">What we build for you</h2>
      <ul class="fixes">
        {
          d.solutions.map((s) => (
            <li class="glass fix">
              <Icon name="check" size={18} strokeWidth={2} class="tick" />
              <h3>{s.title}</h3>
              <p class="muted">{s.text}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="block" aria-labelledby="proof-title">
      <h2 id="proof-title" class="eyebrow">Proof</h2>
      {
        work ? (
          <a href={`/work/${work.id}`} class="glass proof">
            <span class="live">
              <span class="dot" />
              Live
            </span>
            <h3>
              {work.data.title} — {work.data.client}
            </h3>
            <p class="muted">{work.data.summary}</p>
            <span class="more">
              Read the case study <Icon name="arrow" size={16} strokeWidth={2} />
            </span>
          </a>
        ) : (
          <div class="glass proof">
            <h3>Be our first {shortName} partner</h3>
            <p class="muted">
              We’re a young company, so we’d rather be honest than invent case studies. We already run a live queue and booking system for a busy salon, and we’d
              build yours with the same care — starting small, measuring results, and only then growing it.
            </p>
          </div>
        )
      }
    </section>

    {
      services.length > 0 && (
        <section class="block" aria-labelledby="svc-title">
          <h2 id="svc-title" class="eyebrow">Related services</h2>
          <div class="grid">
            {services.map((s) => (
              <ServiceCard service={s} />
            ))}
          </div>
        </section>
      )
    }

    <section class="block" aria-labelledby="other-title">
      <h2 id="other-title" class="eyebrow">Other industries</h2>
      <div class="grid">
        {others.map((i) => <IndustryCard industry={i} />)}
      </div>
    </section>
  </article>

  <ContactSection />
</BaseLayout>

<style>
  .page {
    padding-top: clamp(40px, 7vw, 72px);
  }
  .head {
    max-width: 780px;
  }
  .big {
    width: 60px;
    height: 60px;
    border-radius: 16px;
  }
  .head .eyebrow {
    margin-top: 24px;
  }
  h1 {
    margin-top: 12px;
    font-size: clamp(34px, 5vw, 56px);
    line-height: 1.05;
  }
  .lead {
    margin-top: 18px;
  }
  .ctas {
    margin-top: 28px;
  }
  .block {
    margin-top: 64px;
  }
  .pains {
    margin-top: 18px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(240px, 100%), 1fr));
    gap: 12px;
  }
  .pains li {
    padding: 18px 20px;
    font-size: 15px;
    line-height: 1.55;
    color: var(--text-2);
    border-left: 2px solid rgba(var(--danger-rgb), 0.5);
  }
  .fixes {
    margin-top: 18px;
    list-style: none;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(260px, 100%), 1fr));
    gap: 14px;
  }
  .fix {
    padding: 24px;
  }
  .fix :global(.tick) {
    color: var(--mint);
  }
  .fix h3 {
    margin-top: 12px;
    font-size: 18px;
    letter-spacing: -0.01em;
  }
  .fix p {
    margin-top: 8px;
    font-size: 15px;
    line-height: 1.6;
  }
  .proof {
    margin-top: 18px;
    display: block;
    padding: clamp(22px, 3vw, 32px);
    color: inherit;
    text-decoration: none;
    background: linear-gradient(135deg, rgba(var(--mint-rgb), 0.08), rgba(var(--fg-rgb), 0.02) 60%);
  }
  .proof h3 {
    margin-top: 10px;
    font-size: clamp(19px, 2.2vw, 24px);
  }
  .proof p {
    margin-top: 10px;
    max-width: 680px;
    line-height: 1.65;
  }
  .live {
    display: inline-flex;
    align-items: center;
    gap: 6px;
    padding: 4px 10px;
    border-radius: 999px;
    background: rgba(var(--mint-rgb), 0.12);
    color: var(--mint);
    font-size: 12px;
    font-weight: 500;
  }
  .dot {
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--mint);
    box-shadow: 0 0 10px var(--mint);
  }
  .more {
    margin-top: 16px;
    display: inline-flex;
    align-items: center;
    gap: 6px;
    color: var(--mint);
    font-size: 14px;
    font-weight: 500;
  }
  .grid {
    margin-top: 18px;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(280px, 100%), 1fr));
    gap: 16px;
  }
</style>
