---
import '@/styles/global.css';
import Seo, { type SeoProps } from '@/components/Seo.astro';
import Header from '@/components/Header.astro';
import Footer from '@/components/Footer.astro';
import ChatWidget from '@/components/ChatWidget.astro';
import Motion from '@/components/Motion.astro';

type Props = SeoProps;
const seo = Astro.props;
---

<!doctype html>
<html lang="en-IN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <meta name="theme-color" content="#07090d" media="(prefers-color-scheme: dark)" />
    <meta name="theme-color" content="#f5f7fa" media="(prefers-color-scheme: light)" />
    <script is:inline>
      (function () {
        try {
          var t = localStorage.getItem('theme');
          if (t === 'light' || t === 'dark') {
            document.documentElement.dataset.theme = t;
            var c = t === 'light' ? '#f5f7fa' : '#07090d';
            document.querySelectorAll('meta[name="theme-color"]').forEach(function (m) { m.setAttribute('content', c); });
          }
        } catch (e) {}
      })();
    </script>
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <Seo {...seo} />
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <div class="glows" aria-hidden="true">
      <div class="glow glow--a"></div>
      <div class="glow glow--b"></div>
    </div>
    <Header />
    <main id="main">
      <slot />
    </main>
    <Footer />
    <ChatWidget />
    <Motion />
  </body>
</html>

<style>
  /* Clipping box so the decorative light never widens the page. */
  .glows {
    position: absolute;
    top: 0;
    left: 0;
    right: 0;
    height: 1400px;
    overflow: hidden;
    pointer-events: none;
    z-index: -1;
  }
  .glow {
    position: absolute;
  }
  .glow--a {
    top: -360px;
    left: 50%;
    width: min(1100px, 160vw);
    height: 900px;
    transform: translateX(-50%);
    background: radial-gradient(closest-side, rgba(var(--mint-rgb), 0.16), rgba(var(--mint-rgb), 0) 70%);
  }
  .glow--b {
    top: 120px;
    right: -260px;
    width: 700px;
    height: 700px;
    background: radial-gradient(closest-side, rgba(var(--peri-rgb), 0.12), rgba(var(--peri-rgb), 0) 70%);
  }
  main {
    position: relative;
  }
  @media (prefers-reduced-motion: no-preference) {
    .glow--a {
      animation: aurora-a 22s ease-in-out infinite alternate;
    }
    .glow--b {
      animation: aurora-b 28s ease-in-out infinite alternate;
    }
  }
  @keyframes aurora-a {
    from {
      transform: translateX(-50%) scale(1);
    }
    to {
      transform: translateX(-42%) scale(1.12) rotate(6deg);
    }
  }
  @keyframes aurora-b {
    from {
      transform: translate(0, 0) scale(1);
    }
    to {
      transform: translate(-140px, 120px) scale(1.2);
    }
  }
</style>
